{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palash-newsletter",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "account_id": "6f3882bb6bb2134c973a033d6b5c1dec",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://palashtaneja.com,https://www.palashtaneja.com,https://palash-taneja.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsletter-subscribers",
      "database_id": "e1be0f95-87a3-420a-80bf-add6f804af18",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "palash-newsletter-preview",
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:8080,http://127.0.0.1:8080"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "newsletter-subscribers-preview",
          "database_id": "local-preview",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
